  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token efsc_ emitido pelo EleveFlow. Escopos: comercial:leitura (leads, mensagens, etapas), tarefas:leitura e tarefas:escrita. Fica só no servidor do Office."
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "lead_id. Lead de outra conta responde 404, igual a inexistente.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "limite": {
        "name": "limite",
        "in": "query",
        "description": "Itens por página.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "cursor": {
        "name": "cursor",
        "in": "query",
        "description": "proximo_cursor da página anterior. Opaco.",
        "schema": {
          "type": "string"
        }
      },
      "atualizadoDesde": {
        "name": "atualizado_desde",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "criadoDe": {
        "name": "criado_de",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "criadoAte": {
        "name": "criado_ate",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "etapaId": {
        "name": "etapa_id",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "situacao": {
        "name": "situacao",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["em_andamento", "ganha", "perdida"]
        }
      },
      "tarefaId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "tarefa_id. Tarefa de outra conta responde 404, igual a inexistente.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "statusTarefa": {
        "name": "status",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["pendente", "em_andamento", "aguardando_revisao", "concluida"]
        }
      },
      "responsavelTipo": {
        "name": "responsavel_tipo",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["dono", "agente"]
        }
      },
      "responsavelRef": {
        "name": "responsavel_ref",
        "in": "query",
        "description": "Referência do agente no Office.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "ifMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Versão lida da tarefa (campo versao), entre aspas: \"3\". Diferente da atual: 412 com a tarefa atual. Ausente: 428.",
        "schema": {
          "type": "string",
          "examples": ["\"3\""]
        }
      },
      "idempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Chave única da criação, de 1 a 200 caracteres visíveis, sem espaço. Use o id da ordem ou da tarefa no Office. Repetir com a mesma chave devolve a mesma tarefa (200) e não cria outra.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "schemas": {
      "Etapa": {
        "type": "object",
        "required": ["id", "nome", "tipo"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": ["string", "null"]
          },
          "tipo": {
            "type": ["string", "null"],
            "enum": ["prospecting", "interested", "demo", "proposal", "won", "lost", null],
            "description": "funnel_key da etapa; null = etapa ativa sem classificação."
          }
        }
      },
      "Lead": {
        "type": "object",
        "properties": {
          "lead_id": {
            "type": "string",
            "format": "uuid",
            "description": "Também é o id da oportunidade."
          },
          "nome": {
            "type": "string"
          },
          "empresa": {
            "type": ["string", "null"]
          },
          "origem": {
            "type": ["string", "null"],
            "examples": ["extrator-google"]
          },
          "responsavel": {
            "type": "null",
            "description": "O CRM não registra dono por lead: a conta tem um vendedor."
          },
          "etapa": {
            "oneOf": [
              {
