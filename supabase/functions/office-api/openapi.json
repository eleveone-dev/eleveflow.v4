            "$ref": "#/components/parameters/atualizadoDesde"
          },
          {
            "$ref": "#/components/parameters/criadoDe"
          },
          {
            "$ref": "#/components/parameters/criadoAte"
          },
          {
            "$ref": "#/components/parameters/etapaId"
          },
          {
            "$ref": "#/components/parameters/situacao"
          }
        ],
        "responses": {
          "200": {
            "description": "Página de leads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaLeads"
                }
              }
            }
          },
          "400": {
